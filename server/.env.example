# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real secrets.

PORT=5000
NODE_ENV=development

# Local MongoDB (default). For MongoDB Atlas use the connection string
# from your cluster, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/charubala
MONGO_URI=mongodb://127.0.0.1:27017/charubala

# Any long random string. Change it before deploying.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Where the React dev server runs — used for the CORS allow-list.
CLIENT_ORIGIN=http://localhost:5173
